# ============================================================================
# RETO 02 - AGENTE CONVERSACIONAL DE REGISTRO DE CONTRATOS VIGENTES
# Periferia IT Group · Configuración de Entorno
# ============================================================================

# Proveedor LLM: "gemini" | "openai" | "anthropic" | "auto"
# En modo "auto" detecta automáticamente la primera clave disponible (GEMINI_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY)
# y si ninguna está definida, activa el motor ReAct determinista de respaldo para pruebas locales sin costo.
LLM_PROVIDER=auto

# Claves de API (configura al menos una para usar un modelo en la nube; NUNCA las subas al repositorio)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos por defecto (opcionales)
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Límites de seguridad y control de costos (Sección 6.3 y 8 del PRD)
MAX_ITERATIONS_PER_TURN=25
MAX_TOKENS_PER_SESSION=120000
LLM_TIMEOUT_MS=30000

# Puerto del servidor HTTP (Front + API)
PORT=3000

